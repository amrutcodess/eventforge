# EventForge server environment
# Copy to `.env` and fill in. Never commit the real `.env` (it is gitignored).

# Required. MongoDB connection string.
# Local development:
#   MONGODB_URI=mongodb://127.0.0.1:27017/eventforge
# Production (MongoDB Atlas):
#   MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/eventforge?retryWrites=true&w=majority
# If this is unset in production the server refuses to start rather than silently
# falling back to an in-memory database that discards every write.
MONGODB_URI=mongodb://127.0.0.1:27017/eventforge

# Required. Secret used to sign JWT auth tokens. Use a long random value in production.
JWT_SECRET=change_me_to_a_long_random_string

# Optional. Enables real OpenAI-generated copy. Without it, the AI endpoints fall
# back to a built-in template/heuristic generator, so the app still works.
# OPENAI_API_KEY=

# development | production
NODE_ENV=development

# Local server port (ignored on serverless platforms).
PORT=5000
