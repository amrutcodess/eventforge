# EventForge server environment
# Copy to `.env` and fill in. Never commit the real `.env` (it is gitignored).

# Required. MongoDB connection string.
# Local development:
#   MONGODB_URI=mongodb://127.0.0.1:27017/eventforge
# Production (MongoDB Atlas):
#   MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/eventforge?retryWrites=true&w=majority
# If this is unset in production the server refuses to start rather than silently
# falling back to an in-memory database that discards every write.
MONGODB_URI=mongodb://127.0.0.1:27017/eventforge

# Required. Secret used to sign JWT auth tokens. Use a long random value in production.
JWT_SECRET=change_me_to_a_long_random_string

# --- AI (optional) -----------------------------------------------------------
# Every AI feature has a deterministic path that reads the same live records the UI
# does, so the app is fully functional with none of these set. Setting them upgrades
# the wording, not the availability.
#
# Any OpenAI-compatible endpoint works, because the client is the `openai` SDK with
# `baseURL` overridden. Pick a free hosted provider for the deployed site — a local
# Ollama is reachable from `npm run dev` but NOT from a Vercel function, which cannot
# see localhost.
#
#   Groq        AI_BASE_URL=https://api.groq.com/openai/v1
#               AI_MODEL=llama-3.3-70b-versatile
#   OpenRouter  AI_BASE_URL=https://openrouter.ai/api/v1
#               AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
#   Ollama      AI_BASE_URL=http://localhost:11434/v1
#               AI_MODEL=llama3.1        (AI_API_KEY may be any non-empty string)
#
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Legacy. If AI_BASE_URL is unset and this is set, the client points at OpenAI.
# OPENAI_API_KEY=

# Set to "true" to log AI provider failures (host and model only — never prompts or keys).
AI_DEBUG=false

# development | production
NODE_ENV=development

# Local server port (ignored on serverless platforms).
PORT=5000
